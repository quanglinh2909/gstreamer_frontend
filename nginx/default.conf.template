# Cổng vào duy nhất cho trình duyệt. Frontend (Next.js) và 2 backend chỉ cần
# bind 127.0.0.1; nginx (chạy network_mode: host) là thứ duy nhất mở ra ngoài.
#
# Định tuyến:
#   /       -> Next.js (${FRONTEND_PORT})  — mọi HTTP, kể cả /api/backend/* mà
#              Next tự proxy sang backend ở phía server.
#   /ws/    -> Python backend (${PY_BACKEND_PORT})  — WebSocket sự kiện.
#   /wsc/   -> C++ engine (${CPP_BACKEND_PORT})     — WebSocket camera-state,
#              đổi tiền tố /wsc/ thành /ws/ của backend.
#
# Chỉ WebSocket mới cần lộ trực tiếp vì trình duyệt nối thẳng; HTTP tới backend
# đã đi vòng qua Next nên nằm gọn trong location /.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${NGINX_PORT};
    listen [::]:${NGINX_PORT};
    server_name _;

    # Cho phép upload ảnh (whitelist biển số, ...) đi qua proxy.
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js dev/HMR cũng dùng WebSocket.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Python backend WebSocket — giữ nguyên path /ws/... của backend.
    # Client: WEBSOCKET_ORIGIN=ws://<host>:${NGINX_PORT}/ws
    location /ws/ {
        proxy_pass http://127.0.0.1:${PY_BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # C++ engine WebSocket — /wsc/<x> ánh xạ sang /ws/<x> của backend.
    # Client: WEBSOCKET_ORIGIN_C=ws://<host>:${NGINX_PORT}/wsc
    location /wsc/ {
        proxy_pass http://127.0.0.1:${CPP_BACKEND_PORT}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ─── Cổng HTTPS cho MẠNG LAN ────────────────────────────────────────────────
# Chỉ tồn tại vì MoQ: WebTransport đòi secure context, mà http://<ip-lan>
# không phải. Người xem qua tên miền công khai không dùng cổng này (TLS của họ
# kết thúc ở ingress), nên khối http trên vẫn giữ nguyên, không đụng vào.
#
# Chứng chỉ tự ký -> lần đầu Chrome cảnh báo, bấm Advanced/Proceed một lần là
# xong. Sinh bằng nginx/make-lan-cert.sh.
server {
    listen ${NGINX_TLS_PORT} ssl;
    listen [::]:${NGINX_TLS_PORT} ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/lan.crt;
    ssl_certificate_key /etc/nginx/certs/lan.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:${PY_BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /wsc/ {
        proxy_pass http://127.0.0.1:${CPP_BACKEND_PORT}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
